# ============================================================
# GYREX LABS — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env.local for local development. Never commit real secrets.
# ============================================================

# Database (PostgreSQL)
DATABASE_URL=

# Authentication & Session Secrets
AUTH_SECRET=
SESSION_MAX_AGE_SECONDS=604800
ENCRYPTION_SECRET=
STORAGE_SIGNING_SECRET=

# Domains & Routing
NEXT_PUBLIC_PATIENT_DOMAIN=labs.gyrex.in
NEXT_PUBLIC_SUPERADMIN_DOMAIN=admin-labs.gyrex.in
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI (Prescription Extraction Only - Strictly Investigation Names)
GEMINI_API_KEY=

# Secure Storage Configuration (Private & Non-Public)
STORAGE_PROVIDER=LOCAL_SECURE # LOCAL_SECURE | S3_COMPLIANT
STORAGE_LOCAL_DIR=./storage/secure
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Platform SaaS Gateway (FLOW B: Lab -> Gyrex Subscriptions)
GYREX_RAZORPAY_KEY_ID=
GYREX_RAZORPAY_KEY_SECRET=
GYREX_RAZORPAY_WEBHOOK_SECRET=

# Transactional Email
EMAIL_FROM=notifications@labs.gyrex.in
EMAIL_API_KEY=

# Meta WhatsApp Cloud API (Official API Only)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
